{
  "name": "finanzas-cardenas",
  "version": "0.1.0",
  "description": "FinanzasCardenas: gestión profesional de la economía del hogar (Electron + Node + SQLite).",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-assets.mjs",
    "vendor": "node scripts/vendor-assets.mjs",
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spike:sqlite": "electron spikes/electron-sqlite/main.js",
    "spike:csp": "electron spikes/csp-modals/main.js",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage",
    "smoke": "electron scripts/smoke-electron.mjs",
    "smoke:ui": "electron scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "axe-core": "4.14.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "sweetalert2": "11.26.25"
  }
}
